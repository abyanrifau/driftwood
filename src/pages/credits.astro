---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Photo from '../components/Photo.astro';
import { credits, photoSource, photoUrl, photographerUrl } from '../data/credits';
import { breadcrumbs } from '../lib/schema';

const trail = [
  { name: 'Home', path: '/' },
  { name: 'Photo credits', path: '/credits/' },
];
---

<Base
  title="Photo credits | Driftwood, a Nuit Works concept"
  description="Every photograph on the Driftwood concept site, with its photographer and source. All images are from Unsplash, graded to one warm look."
  og="credits"
  schema={[breadcrumbs(Astro.site!, trail)]}
>
  <PageHero
    eyebrow="Credits"
    title="Photo credits"
    lede={`Every photograph on this concept site comes from ${photoSource.name} under the ${photoSource.license}. Each one is downloaded, graded to the same warm light and served from this site.`}
    trail={trail}
  />

  <section class="container credits-wrap" aria-label="Photos and photographers">
    <ul role="list" class="credits">
      {
        credits.map((c) => (
          <li class="credit">
            <div class="credit-thumb">
              <Photo name={c.key} alt="" aspect={1} widths={[120, 240]} sizes="96px" />
            </div>
            <div>
              <p class="credit-subject">{c.subject}</p>
              <p class="credit-by">
                Photo by <a href={photographerUrl(c)}>{c.photographer}</a> on <a href={photoUrl(c)}>Unsplash</a>
              </p>
            </div>
          </li>
        ))
      }
    </ul>
    <p class="muted small credits-fonts">
      Type: Cormorant Garamond by Christian Thalmann and Jost by Owen Earl, both under the SIL Open Font License and served from this site.
      The island map is an original drawing.
    </p>
  </section>
</Base>

<style>
  .credits-wrap {
    padding-bottom: var(--space-2xl);
  }
  .credits {
    display: grid;
    gap: 0.5rem 2rem;
  }
  @media (min-width: 760px) {
    .credits {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1100px) {
    .credits {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .credit {
    display: flex;
    gap: 1rem;
    align-items: center;
    padding-block: 0.6rem;
    border-bottom: 1px solid var(--hairline);
  }
  .credit-thumb {
    flex: none;
    width: 72px;
    height: 72px;
    overflow: hidden;
    background: var(--sand);
  }
  .credit-thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .credit-subject {
    font-weight: 400;
    line-height: 1.35;
  }
  .credit-by {
    font-size: var(--step--1);
    color: var(--stone-text);
  }
  .credits-fonts {
    margin-top: 2rem;
  }
</style>
