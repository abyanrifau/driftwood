---
import Base from '../layouts/Base.astro';
import BookBar from '../components/islands/BookBar';
import SectionHead from '../components/SectionHead.astro';
import RoomSpread from '../components/RoomSpread.astro';
import ExperienceEntry from '../components/ExperienceEntry.astro';
import Photo from '../components/Photo.astro';
import ArtPhoto from '../components/ArtPhoto.astro';
import IslandMap from '../components/IslandMap.astro';
import SeasonTeaser from '../components/SeasonTeaser.astro';
import Reviews from '../components/Reviews.astro';
import CtaBand from '../components/CtaBand.astro';
import { site, perks } from '../data/site';
import { rooms, totalRooms, lowestPrice } from '../data/rooms';
import { experiences } from '../data/experiences';
import { seasonalUrgency } from '../data/seasons';
import { transfers, transfersNote } from '../data/transfers';
import { artDirected } from '../lib/images';
import { bookUrl } from '../lib/booking';
import { lodgingBusiness } from '../lib/schema';
import { toISO } from '../lib/dates';

const heroAlt = 'Canopy daybed on a terrace, its linen curtains framing a turquoise lagoon';
const heroMedia = '(max-aspect-ratio: 1/1)';
const hero = await artDirected('hero-wide', heroAlt, {
  aspect: 16 / 9,
  mobileKey: 'hero-tall',
  // A phone hero fills a tall screen, so its crop is upright 2:3 rather than 4:5.
  mobileAspect: 2 / 3,
  widths: [960, 1280, 1600, 2000, 2400],
  mobileWidths: [480, 750, 1080],
  quality: { avif: 42, webp: 60 },
  mobileQuality: { avif: 30, webp: 50 },
});
const preloads = [
  { srcset: hero.mobile.avif, sizes: '100vw', type: 'image/avif', media: heroMedia },
  { srcset: hero.desktop.avif, sizes: '100vw', type: 'image/avif', media: '(min-aspect-ratio: 1/1)' },
];
const spreadPhoto: Record<string, number> = { 'reef-view-room': 0, 'garden-suite': 2, 'beachfront-room': 1, 'rooftop-suite': 2 };
const today = toISO(new Date());
const schema = [lodgingBusiness(Astro.site!, new URL('/og/home.jpg', Astro.site).href)];
---

<Base
  title="Driftwood, a 12-room guesthouse on Maafushi, Maldives"
  description="Twelve rooms on Maafushi, two minutes on foot from the house reef. Four room types from $180 a night with breakfast. Book direct with free cancellation."
  og="home"
  overlayHeader
  schema={schema}
  preloadImages={preloads}
  mobileBar={{ startHidden: true }}
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-media">
      <picture>
        <source type="image/avif" media={heroMedia} srcset={hero.mobile.avif} sizes="100vw" />
        <source type="image/webp" media={heroMedia} srcset={hero.mobile.webp} sizes="100vw" />
        <source type="image/avif" srcset={hero.desktop.avif} sizes="100vw" />
        <source type="image/webp" srcset={hero.desktop.webp} sizes="100vw" />
        <img
          src={hero.desktop.src}
          alt={heroAlt}
          width={hero.desktop.width}
          height={hero.desktop.height}
          fetchpriority="high"
          loading="eager"
          decoding="async"
        />
      </picture>
    </div>
    <span class="header-sentinel" data-header-sentinel aria-hidden="true"></span>
    <div class="container hero-inner on-dark">
      <p class="hero-place">Maafushi · Kaafu Atoll · Maldives</p>
      <h1 id="hero-title">A twelve-room guesthouse on Maafushi</h1>
      <p class="hero-sub">Four room types, two minutes from the house reef. Breakfast included.</p>
    </div>
    <a class="hero-scroll on-dark" href="#availability" aria-label="Scroll to check availability">
      <span aria-hidden="true">Scroll</span>
      <span class="hero-scroll-line" aria-hidden="true"></span>
    </a>
  </section>

  <section class="booking-band" id="availability" aria-label="Check availability" data-hide-bar>
    <div class="container">
      <BookBar client:visible variant="bar" today={today} id="home" />
      <ul role="list" class="perk-line">
        {perks.map((p) => <li>{p.title}</li>)}
      </ul>
    </div>
  </section>

  <section class="section intro-band" aria-labelledby="intro-title">
    <div class="container intro-grid">
      <h2 id="intro-title" class="eyebrow">Driftwood, Maafushi</h2>
      <div class="intro-text" data-reveal>
        <p class="intro-statement serif">
          Twelve rooms on the south side of Maafushi, a local island in Kaafu Atoll. The house reef is two minutes away on foot.
        </p>
        <dl class="facts">
          <div><dt>Rooms</dt><dd>{totalRooms}, in {rooms.length} types</dd></div>
          <div><dt>Rates</dt><dd>From ${lowestPrice} per night</dd></div>
          <div><dt>Breakfast</dt><dd>Included, 7 to 10am</dd></div>
          <div><dt>Airport</dt><dd>35 minutes by speedboat</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <!-- 01 The house -->
  <section class="chapter" aria-labelledby="house-title">
    <div class="container">
      <SectionHead number={1} eyebrow="The house" title="Coral stone, teak and lime plaster" id="house-title" />
    </div>
    <figure class="bleed" data-reveal-img>
      <div class="bleed-img">
        <ArtPhoto
          name="house"
          alt="Whitewashed veranda with white columns, opening onto a lawn, palms and a long pool"
          aspect={21 / 9}
          mobileAspect={4 / 5}
          widths={[1080, 1600, 2000, 2400]}
        />
      </div>
      <figcaption class="container caption">The veranda, late afternoon</figcaption>
    </figure>
    <div class="container pair">
      <figure class="pair-large">
        <div class="frame" data-reveal-img>
          <Photo name="villa-terrace" alt="Limestone terrace with two rattan loungers beside a small plunge pool" aspect={4 / 5} widths={[480, 750, 960, 1200]} sizes="(min-width: 900px) 46vw, 100vw" />
        </div>
        <figcaption class="caption">Garden terrace, 10am</figcaption>
      </figure>
      <div class="pair-side">
        <div class="pair-text" data-reveal>
          <p>
            Two storeys around a garden and a small pool, built between 2019 and 2023. Floors are reclaimed teak, walls are coral stone
            finished in lime plaster by hand, and every bed is made with washed linen.
          </p>
          <a class="text-link" href="/about/">About the house</a>
        </div>
        <figure class="pair-small">
          <div class="frame" data-reveal-img>
            <Photo name="plaster-shutter" alt="Timber shutter set in a plaster wall, with palm shadows" aspect={3 / 2} widths={[480, 750, 960]} sizes="(min-width: 900px) 30vw, 100vw" />
          </div>
          <figcaption class="caption">Lime plaster and teak shutters</figcaption>
        </figure>
      </div>
    </div>
    <div class="container portrait-text">
      <figure class="portrait-img">
        <div class="frame" data-reveal-img>
          <Photo name="breakfast" alt="Bowls of watermelon, yoghurt and fruit on a terrace table, with juice and the sea behind" aspect={3 / 4} widths={[480, 750, 960]} sizes="(min-width: 900px) 34vw, 100vw" />
        </div>
        <figcaption class="caption">Breakfast on the terrace, 8am</figcaption>
      </figure>
      <div class="portrait-copy" data-reveal>
        <h3>Breakfast on the terrace</h3>
        <p>
          Served from 7 to 10am and included for every guest: fruit, eggs to order, roshi with mas huni, fresh juice, coffee and tea.
        </p>
      </div>
    </div>
  </section>

  <!-- 02 Rooms -->
  <section class="chapter" aria-labelledby="rooms-title">
    <div class="container">
      <SectionHead number={2} eyebrow="Rooms" title="Four room types" id="rooms-title" lede="Twelve rooms in all, each with its own balcony, courtyard, veranda or terrace. Rates include breakfast." split>
        <a class="text-link" href="/rooms/">View all rooms</a>
      </SectionHead>
      <div class="spreads">
        {rooms.map((r, i) => <RoomSpread room={r} index={i} photo={spreadPhoto[r.slug]} transition />)}
      </div>
      <div class="seasons" data-reveal>
        <div class="seasons-head">
          <h3 class="label">Rates through the year</h3>
          <p>{seasonalUrgency.headline} {seasonalUrgency.detail}</p>
          <a class="text-link" href="/rooms/#calendar">See every date</a>
        </div>
        <SeasonTeaser />
      </div>
    </div>
  </section>

  <!-- 03 The reef -->
  <section class="chapter" aria-labelledby="reef-title">
    <div class="container reef">
      <figure class="reef-tall">
        <div class="frame" data-reveal-img>
          <Photo name="reef-split" alt="The house reef at the waterline: coral below, palms and the island above" aspect={3 / 4} widths={[480, 750, 960, 1200]} sizes="(min-width: 900px) 46vw, 100vw" />
        </div>
        <figcaption class="caption">House reef, 8am</figcaption>
      </figure>
      <div class="reef-copy">
        <SectionHead number={3} eyebrow="The reef" title="Two minutes from the door" id="reef-title" />
        <div class="body-copy stack" data-reveal>
          <p>
            The lagoon in front of the house is shallow and sandy for about forty metres, then drops to the reef wall at around twelve
            metres. Green and hawksbill turtles feed along the edge most mornings.
          </p>
          <p>Masks, snorkels and fins are free to borrow. A guided swim leaves from the beach at 8:30 every morning.</p>
          <a class="text-link" href={bookUrl({ exp: 'snorkeling-house-reef' })} data-astro-reload data-booking-start aria-label="Add to booking: guided snorkeling">Add to booking</a>
        </div>
        <figure class="reef-small">
          <div class="frame" data-reveal-img>
            <Photo name="reef-coral" alt="Branching coral with a cloud of small orange reef fish" aspect={3 / 2} widths={[480, 750, 960]} sizes="(min-width: 900px) 28vw, 100vw" />
          </div>
          <figcaption class="caption">Hard coral on the reef wall</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- 04 Days out -->
  <section class="chapter" aria-labelledby="days-title">
    <div class="container">
      <SectionHead number={4} eyebrow="Days out" title="Four ways to spend a day" id="days-title" lede="Small groups with local guides, priced per person. Add them when you book, or arrange them once you are here." split>
        <a class="text-link" href="/experiences/">View all experiences</a>
      </SectionHead>
    </div>
    <figure class="bleed" data-reveal-img>
      <div class="bleed-img">
        <ArtPhoto
          name="sandbank-wide"
          alt="A curved white sandbank in a turquoise lagoon, seen from above"
          aspect={21 / 9}
          mobileAspect={4 / 5}
          widths={[1080, 1600, 2000, 2400]}
        />
      </div>
      <figcaption class="container caption">The sandbank, fifteen minutes by boat</figcaption>
    </figure>
    <div class="container entries">
      {experiences.map((e, i) => <ExperienceEntry experience={e} shape={i === 0 || i === 3 ? 'tall' : 'wide'} delay={(i % 2) * 0.12} />)}
    </div>
  </section>

  <!-- 05 Getting here -->
  <section class="chapter chapter--last" aria-labelledby="getting-title">
    <div class="container">
      <SectionHead number={5} eyebrow="Getting here" title="Thirty-five minutes from the airport" id="getting-title" />
    </div>
    <figure class="bleed" data-reveal-img>
      <div class="bleed-img">
        <ArtPhoto
          name="speedboat"
          alt="A speedboat crossing open water towards a palm-covered island"
          aspect={21 / 9}
          mobileAspect={4 / 5}
          widths={[1080, 1600, 2000, 2400]}
        />
      </div>
      <figcaption class="container caption">Shared speedboat, Velana to Maafushi</figcaption>
    </figure>
    <div class="container getting">
      <div class="getting-copy" data-reveal>
        <p>
          Driftwood is on Maafushi in Kaafu Atoll, south of Malé. We meet every boat at the jetty, five minutes from the house, with a
          trolley for your luggage.
        </p>
        <table class="transfer-table">
          <caption class="visually-hidden">Ways to reach Maafushi from {site.location.airport}</caption>
          <tbody>
            {
              transfers.map((t) => (
                <tr>
                  <th scope="row">{t.name}</th>
                  <td>{t.crossing}</td>
                  <td>{t.priceLabel}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
        <p class="caption">{transfersNote}</p>
        <a class="text-link" href="/getting-here/">Getting here, step by step</a>
      </div>
    </div>
    <div class="container island">
      <h3 class="island-title">On the island</h3>
      <IslandMap id="home-map" />
    </div>
  </section>

  <Reviews count={3} />

  <CtaBand caption="Maafushi, 6pm" />
</Base>

<style>
  /* Hero ----------------------------------------------------------------- */
  .hero {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: flex-end;
    min-height: 100vh;
    min-height: 100svh;
    color: var(--cream);
    overflow: hidden;
  }
  /* On wider screens the booking bar sits just inside the first screen. */
  @media (min-width: 900px) {
    .hero {
      min-height: calc(100svh - 86px);
    }
  }
  .hero-media {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: #6f8f8d;
  }
  .hero-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 60%;
  }
  /* A soft gradient at the foot of the photo only, for the text */
  .hero-media::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgb(30 26 23 / 0.32) 0%, rgb(30 26 23 / 0) 18%),
      linear-gradient(0deg, rgb(30 26 23 / 0.62) 0%, rgb(30 26 23 / 0.4) 32%, rgb(30 26 23 / 0.12) 58%, rgb(30 26 23 / 0) 72%);
  }
  .header-sentinel {
    position: absolute;
    top: 0;
    left: 0;
    width: 1px;
    height: 40px;
  }
  .hero-inner {
    display: grid;
    gap: 1.1rem;
    padding-top: calc(var(--header-h) + 2rem);
    padding-bottom: clamp(5.5rem, 12vh, 7.5rem);
  }
  .hero-place {
    font-size: 0.7rem;
    font-weight: 400;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgb(246 242 236 / 0.92);
  }
  .hero h1 {
    max-width: 13ch;
    font-size: clamp(2.9rem, 1.7rem + 4.6vw, 6.2rem);
    font-weight: 300;
    line-height: 1.02;
  }
  .hero-sub {
    max-width: 30rem;
    font-size: var(--step-0);
    font-weight: 400;
    color: rgb(246 242 236 / 0.92);
  }
  .hero-scroll {
    position: absolute;
    left: 50%;
    bottom: 1.25rem;
    display: grid;
    justify-items: center;
    gap: 0.6rem;
    transform: translateX(-50%);
    color: var(--cream);
    font-size: 0.64rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    text-decoration: none;
  }
  .hero-scroll-line {
    width: 1px;
    height: 44px;
    background: linear-gradient(rgb(246 242 236 / 0.85), rgb(246 242 236 / 0));
    transform-origin: top;
    animation: scroll-line 2.6s var(--ease-out) infinite;
  }
  @keyframes scroll-line {
    0% {
      transform: scaleY(0);
    }
    60%,
    100% {
      transform: scaleY(1);
      opacity: 0;
    }
  }
  @media (max-width: 899px) {
    .hero-inner {
      padding-bottom: calc(var(--bar-h) + 5.5rem);
    }
    .hero-scroll {
      bottom: calc(var(--bar-h) + 1rem);
    }
    .hero-scroll-line {
      height: 32px;
    }
  }

  /* Booking bar ------------------------------------------------------------- */
  .booking-band {
    position: relative;
    z-index: 5;
    background: var(--cream);
  }
  .booking-band .container {
    padding-top: 0;
  }
  @media (max-width: 899px) {
    .booking-band .container {
      padding-top: var(--space-l);
    }
  }
  .perk-line {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0;
    padding-top: 1.1rem;
    font-size: 0.66rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--taupe-ink);
  }
  .perk-line li + li::before {
    content: '·';
    margin-inline: 0.9rem;
  }

  /* Intro --------------------------------------------------------------------- */
  .intro-band {
    padding-block: var(--space-2xl) var(--space-3xl);
  }
  .intro-grid {
    display: grid;
    gap: 1.75rem;
  }
  @media (min-width: 900px) {
    .intro-grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: 3rem;
    }
    .intro-grid > h2 {
      grid-column: 1 / span 3;
      padding-top: 0.9rem;
    }
    .intro-text {
      grid-column: 5 / span 7;
    }
  }
  .intro-statement {
    max-width: 22ch;
    font-size: var(--step-3);
    font-weight: 300;
    line-height: 1.22;
    text-wrap: balance;
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem 2rem;
    margin-top: var(--space-xl);
    padding-top: 1.5rem;
    border-top: 1px solid var(--hairline);
    max-width: 40rem;
  }
  @media (min-width: 640px) {
    .facts {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .facts dt {
    font-size: 0.66rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--taupe-ink);
  }
  .facts dd {
    margin: 0.3rem 0 0;
    font-size: var(--step--1);
  }

  /* Chapters ------------------------------------------------------------------ */
  .chapter {
    padding-bottom: var(--space-3xl);
  }
  .chapter--last {
    padding-bottom: var(--space-2xl);
  }
  .bleed {
    margin-bottom: var(--space-2xl);
  }
  .bleed-img {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--sand);
  }
  @media (min-width: 768px) {
    .bleed-img {
      aspect-ratio: 21 / 9;
    }
  }
  .bleed-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* 01: an asymmetric pair, then a portrait beside a short text */
  .pair {
    display: grid;
    gap: 2.5rem;
  }
  @media (min-width: 900px) {
    .pair {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: clamp(1.5rem, 3vw, 3rem);
    }
    .pair-large {
      grid-column: 1 / span 6;
    }
    .pair-side {
      grid-column: 8 / span 5;
      display: grid;
      align-content: space-between;
      gap: 3rem;
      padding-top: 4rem;
    }
    .pair-small {
      margin-right: -3rem;
    }
  }
  .pair-text {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
    max-width: 26rem;
  }
  .portrait-text {
    display: grid;
    gap: 2rem;
    margin-top: var(--space-3xl);
    align-items: center;
  }
  @media (min-width: 900px) {
    .portrait-text {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: clamp(1.5rem, 3vw, 3rem);
    }
    .portrait-img {
      grid-column: 3 / span 4;
    }
    .portrait-copy {
      grid-column: 8 / span 4;
    }
  }
  .portrait-copy {
    display: grid;
    gap: 1rem;
    max-width: 22rem;
  }
  .portrait-copy h3 {
    font-size: var(--step-3);
    font-weight: 300;
  }

  /* 02: room spreads and the season strip */
  .spreads {
    display: grid;
    gap: var(--space-2xl);
  }
  .seasons {
    display: grid;
    gap: 2rem;
    margin-top: var(--space-3xl);
    padding-top: var(--space-l);
    border-top: 1px solid var(--hairline);
  }
  @media (min-width: 1080px) {
    .seasons {
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
      column-gap: 4rem;
    }
  }
  .seasons-head {
    display: grid;
    gap: 1rem;
    justify-items: start;
    align-content: start;
    max-width: 24rem;
    color: var(--ink-soft);
  }

  /* 03: a tall portrait beside a short text column */
  .reef {
    display: grid;
    gap: 2.5rem;
  }
  @media (min-width: 900px) {
    .reef {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: clamp(1.5rem, 3vw, 3rem);
      align-items: start;
    }
    .reef-tall {
      grid-column: 1 / span 6;
    }
    .reef-copy {
      grid-column: 8 / span 4;
      padding-top: 3rem;
    }
  }
  .reef-copy :global(.section-head) {
    margin-bottom: 2rem;
  }
  .reef-copy .body-copy {
    max-width: 26rem;
  }
  .reef-small {
    margin-top: var(--space-xl);
  }
  @media (min-width: 900px) {
    .reef-small {
      width: 78%;
      margin-left: -14%;
    }
  }

  /* 04: experiences in an offset two-column grid */
  .entries {
    display: grid;
    gap: var(--space-xl);
  }
  @media (min-width: 900px) {
    .entries {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: clamp(1.5rem, 3vw, 3rem);
      row-gap: var(--space-2xl);
    }
    .entries > :global(*:nth-child(odd)) {
      grid-column: 1 / span 5;
    }
    .entries > :global(*:nth-child(even)) {
      grid-column: 7 / span 6;
      margin-top: 8rem;
    }
  }

  /* 05: transfers and the map */
  .getting {
    display: grid;
  }
  .getting-copy {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
    max-width: 44rem;
  }
  @media (min-width: 900px) {
    .getting-copy {
      margin-left: calc(100% / 12 * 4);
    }
  }
  .transfer-table {
    width: 100%;
    border-top: 1px solid var(--hairline);
    font-size: var(--step--1);
  }
  .transfer-table th,
  .transfer-table td {
    padding: 0.9rem 1rem 0.9rem 0;
    border-bottom: 1px solid var(--hairline);
    text-align: left;
    font-weight: 400;
    vertical-align: top;
  }
  .transfer-table td {
    color: var(--ink-soft);
  }
  @media (max-width: 639px) {
    .transfer-table tr {
      display: grid;
      padding: 0.8rem 0;
      border-bottom: 1px solid var(--hairline);
    }
    .transfer-table th,
    .transfer-table td {
      padding: 0;
      border: 0;
    }
  }
  .island {
    margin-top: var(--space-3xl);
  }
  .island-title {
    margin-bottom: var(--space-l);
    font-size: var(--step-3);
    font-weight: 300;
  }
</style>
