---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import FaqList from '../components/FaqList.astro';
import CtaBand from '../components/CtaBand.astro';
import { faqs, faqTopics } from '../data/faq';
import { site, whatsappLink } from '../data/site';
import { breadcrumbs, faqPage } from '../lib/schema';

const trail = [
  { name: 'Home', path: '/' },
  { name: 'FAQ', path: '/faq/' },
];
const slug = (t: string) => t.toLowerCase().replace(/[^a-z]+/g, '-');
const groups = faqTopics.map((topic) => ({ topic, id: slug(topic), items: faqs.filter((f) => f.topic === topic) }));
---

<Base
  title="FAQ: transfers, local island rules, payment | Driftwood"
  description="Answers on airport transfers, the bikini beach and local island rules, alcohol, payment, cancellation, children, the best months, Wi-Fi and power."
  og="faq"
  schema={[faqPage(faqs), breadcrumbs(Astro.site!, trail)]}
>
  <PageHero
    eyebrow="Questions"
    title="Questions"
    lede="Answers to what guests ask most before booking. For anything else, message us and we reply within a few hours."
    trail={trail}
  >
    <nav aria-label="Topics" class="faq-topics">
      <ul role="list">
        {groups.map((g) => <li><a class="text-link" href={`#${g.id}`}>{g.topic}</a></li>)}
      </ul>
    </nav>
  </PageHero>

  <div class="container container--narrow faq-body">
    {
      groups.map((g) => (
        <section class="faq-group" id={g.id} aria-labelledby={`${g.id}-title`}>
          <h2 id={`${g.id}-title`}>{g.topic}</h2>
          <FaqList items={g.items} />
        </section>
      ))
    }

    <aside class="faq-ask" aria-labelledby="ask-title">
      <h2 id="ask-title">Other questions</h2>
      <p>{site.contact.replyTime}</p>
      <div class="faq-ask-links">
        <a class="btn btn--secondary" href={whatsappLink('Hello Driftwood, a question:')}>Contact us on WhatsApp</a>
        <a class="text-link" href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
      </div>
    </aside>
  </div>

  <CtaBand />
</Base>

<style>
  .faq-topics ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.75rem;
  }
  .faq-body {
    display: grid;
    gap: var(--space-xl);
    padding-bottom: var(--space-2xl);
  }
  .faq-group h2 {
    font-size: var(--step-3);
    margin-bottom: 1.25rem;
  }
  .faq-ask {
    display: grid;
    gap: 1rem;
    padding: 2rem;
    border: 1px solid var(--hairline);
    background: var(--ivory);
  }
  .faq-ask h2 {
    font-size: var(--step-2);
  }
  .faq-ask-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
  }
</style>
