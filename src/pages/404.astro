---
import Base from '../layouts/Base.astro';
import ArtPhoto from '../components/ArtPhoto.astro';
import { mainNav } from '../data/site';
---

<Base
  title="Page not found | Driftwood, Maafushi"
  description="The page you were looking for is not here. Links to the rooms, experiences, getting here, booking and contact pages."
  og="404"
  noindex
>
  <section class="nf">
    <div class="nf-bg" aria-hidden="true">
      <ArtPhoto name="wet-sand" alt="" aspect={16 / 9} mobileAspect={2 / 3} widths={[960, 1600, 2400]} mobileWidths={[480, 750, 1080]} priority />
    </div>
    <div class="container nf-inner on-dark">
      <p class="eyebrow nf-eyebrow">Error 404</p>
      <h1>Page not found</h1>
      <p class="nf-lede">The address may have changed or been mistyped. The main pages of the site are listed below.</p>
      <a class="btn btn--light" href="/book/" data-astro-reload data-booking-start>Check availability</a>
      <nav aria-label="Main pages" class="nf-links">
        <ul role="list">
          <li><a href="/">Home</a></li>
          {mainNav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
        </ul>
      </nav>
    </div>
  </section>
</Base>

<style>
  .nf {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: flex-end;
    min-height: calc(100svh - var(--header-h));
    color: var(--cream);
    overflow: hidden;
  }
  .nf-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: #6d5f52;
  }
  .nf-bg :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .nf-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgb(30 26 23 / 0.66) 0%, rgb(30 26 23 / 0.3) 40%, rgb(30 26 23 / 0) 70%);
  }
  .nf-inner {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
    padding-block: var(--space-xl);
  }
  .nf-eyebrow {
    color: rgb(246 242 236 / 0.9);
  }
  .nf-lede {
    max-width: 30rem;
  }
  .nf-links ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    margin-top: 0.75rem;
  }
  .nf-links a {
    display: inline-block;
    padding-block: 0.5rem;
    color: var(--cream);
    font-size: 0.72rem;
    letter-spacing: var(--tracking);
    text-transform: uppercase;
    text-decoration-color: rgb(246 242 236 / 0.5);
  }
</style>
