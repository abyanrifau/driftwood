---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHead from '../../components/SectionHead.astro';
import Reviews from '../../components/Reviews.astro';
import CtaBand from '../../components/CtaBand.astro';
import RoomExplorer, { type ExplorerRoom } from '../../components/islands/RoomExplorer';
import SeasonCalendar from '../../components/islands/SeasonCalendar';
import { rooms, totalRooms, lowestPrice, roomDetailLine } from '../../data/rooms';
import { perks } from '../../data/site';
import { picData } from '../../lib/images';
import { breadcrumbs } from '../../lib/schema';
import { toISO } from '../../lib/dates';

const explorerRooms: ExplorerRoom[] = await Promise.all(
  rooms.map(async (r) => ({
    slug: r.slug,
    name: r.name,
    fromPrice: r.fromPrice,
    bed: r.bed,
    sleepsLabel: r.sleepsLabel,
    sizeM2: r.sizeM2,
    view: r.view,
    outdoorSpace: r.outdoorSpace,
    highlight: r.highlight,
    summary: r.summary,
    standout: r.standout,
    detail: roomDetailLine(r),
    captions: r.photos.map((p) => p.caption),
    photos: await Promise.all(
      r.photos.map((p) => picData(p.key, p.alt, { aspect: 3 / 2, widths: [480, 750, 1080, 1400], sizes: '(min-width: 960px) 56vw, 100vw' })),
    ),
    thumb: await picData(r.photos[0].key, '', { aspect: 3 / 2, widths: [280, 560], sizes: '280px' }),
  })),
);

const trail = [
  { name: 'Home', path: '/' },
  { name: 'Rooms', path: '/rooms/' },
];
const today = toISO(new Date());
---

<Base
  title="Rooms at Driftwood, Maafushi: from $180 a night"
  description="Twelve rooms in four types: Reef View Room, Garden Suite, Beachfront Room and Rooftop Suite. Compare them, see rates for every date and book direct."
  og="rooms"
  schema={[breadcrumbs(Astro.site!, trail)]}
>
  <PageHero
    eyebrow={`${totalRooms} rooms · ${rooms.length} types`}
    title="Rooms"
    lede={`Every room has its own balcony, courtyard, veranda or terrace. Rates start at $${lowestPrice} per night with breakfast, before taxes.`}
    trail={trail}
  >
    <ul role="list" class="perk-list">
      {perks.map((p) => <li>{p.title}</li>)}
    </ul>
  </PageHero>

  <section class="rooms-list" aria-labelledby="explorer-title">
    <div class="container">
      <h2 id="explorer-title" class="visually-hidden">The four room types</h2>
      <RoomExplorer client:visible rooms={explorerRooms} />
    </div>
  </section>

  <section class="section section--ivory cv" id="calendar" aria-labelledby="calendar-title">
    <div class="container">
      <SectionHead
        eyebrow="Seasonal rates"
        title="Rates for every date"
        id="calendar-title"
        lede="The next twelve months, shaded by rate for each room type. Choose a check-in and a check-out date to open booking with both filled in."
      />
      <SeasonCalendar client:visible today={today} />
    </div>
  </section>

  <Reviews />

  <CtaBand photo="rooftop-2" caption="Rooftop Suite, terrace, 6pm" />
</Base>

<style>
  .perk-list {
    display: grid;
    gap: 0.4rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--hairline);
    font-size: 0.66rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--taupe-ink);
  }
  .rooms-list {
    padding-bottom: var(--space-3xl);
  }
</style>
