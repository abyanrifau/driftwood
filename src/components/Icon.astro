---
/** Small inline icons. Decorative unless a label is passed. */
interface Props {
  name: 'whatsapp' | 'mail' | 'instagram' | 'arrow' | 'check' | 'bed' | 'guests' | 'size' | 'sun' | 'wave' | 'clock' | 'boat' | 'leaf' | 'tag' | 'calendar' | 'pin';
  size?: number;
  label?: string;
  class?: string;
}
const { name, size = 20, label, class: className } = Astro.props;
const paths: Record<Props['name'], string> = {
  whatsapp:
    '<path d="M12 2.5a9.4 9.4 0 0 0-8.1 14.2L2.5 21.5l4.9-1.3A9.4 9.4 0 1 0 12 2.5Z" fill="none" stroke="currentColor" stroke-width="1" stroke-linejoin="miter"/><path d="M8.6 7.7c.2-.4.5-.4.8-.4h.6c.2 0 .4.1.5.4l.8 1.9c.1.2 0 .5-.1.7l-.6.7c-.1.1-.2.3 0 .5.5.9 1.1 1.6 1.9 2.2.6.4 1 .6 1.3.7.2.1.4 0 .5-.1l.8-.9c.2-.2.4-.2.6-.1l1.8.9c.2.1.4.3.3.5 0 .5-.2 1.2-.7 1.6-.5.4-1.4.6-2.4.3a10.2 10.2 0 0 1-5.6-5c-.5-1-.7-2.1-.1-3Z" fill="currentColor"/>',
  mail: '<rect x="3" y="5" width="18" height="14" fill="none" stroke="currentColor" stroke-width="1"/><path d="m4 7 8 6 8-6" fill="none" stroke="currentColor" stroke-width="1"/>',
  instagram:
    '<rect x="3.5" y="3.5" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1"/><circle cx="17.2" cy="6.8" r="1.1" fill="currentColor"/>',
  arrow: '<path d="M4 12h15m-6-6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="1" stroke-linejoin="miter"/>',
  check: '<path d="m5 12.5 4.2 4.2L19 7" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linejoin="miter"/>',
  bed: '<path d="M3 18v-7m0 3h18v4m0-4v-2a3 3 0 0 0-3-3h-7v5M7.5 11a1.5 1.5 0 1 0 0-.01" fill="none" stroke="currentColor" stroke-width="1" stroke-linejoin="miter"/>',
  guests: '<circle cx="9" cy="8" r="3.2" fill="none" stroke="currentColor" stroke-width="1"/><path d="M3 19c.6-3.3 3-5 6-5s5.4 1.7 6 5M16 5.5a3 3 0 0 1 0 5.6M18 14.3c1.7.6 2.7 2.2 3 4.7" fill="none" stroke="currentColor" stroke-width="1"/>',
  size: '<path d="M4 9V4h5M20 15v5h-5M4 4l6 6M20 20l-6-6" fill="none" stroke="currentColor" stroke-width="1" stroke-linejoin="miter"/>',
  sun: '<circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1"/><path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6" stroke="currentColor" stroke-width="1"/>',
  wave: '<path d="M2.5 9c2.4 0 2.4-2 4.75-2S9.6 9 12 9s2.4-2 4.75-2S19.1 9 21.5 9M2.5 15c2.4 0 2.4-2 4.75-2S9.6 15 12 15s2.4-2 4.75-2 2.35 2 4.75 2" fill="none" stroke="currentColor" stroke-width="1"/>',
  clock: '<circle cx="12" cy="12" r="8.5" fill="none" stroke="currentColor" stroke-width="1"/><path d="M12 7.5V12l3 2" fill="none" stroke="currentColor" stroke-width="1"/>',
  boat: '<path d="M3 15.5h18l-2.5 4h-13L3 15.5ZM12 3.5v12M12 4.5l6 9H12" fill="none" stroke="currentColor" stroke-width="1" stroke-linejoin="miter"/>',
  leaf: '<path d="M5 19c0-8 5-13 14-14 0 9-5 14-13 14H5Zm0 0 8-8" fill="none" stroke="currentColor" stroke-width="1" stroke-linejoin="miter"/>',
  tag: '<path d="M3.5 12.2V4.5a1 1 0 0 1 1-1h7.7l8.3 8.3a1 1 0 0 1 0 1.4l-7.7 7.7a1 1 0 0 1-1.4 0l-7.9-8.7Z" fill="none" stroke="currentColor" stroke-width="1" stroke-linejoin="miter"/><circle cx="8" cy="8" r="1.4" fill="currentColor"/>',
  calendar: '<rect x="3.5" y="5" width="17" height="15.5" fill="none" stroke="currentColor" stroke-width="1"/><path d="M3.5 10h17M8 3v4M16 3v4" stroke="currentColor" stroke-width="1"/>',
  pin: '<path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11Z" fill="none" stroke="currentColor" stroke-width="1"/><circle cx="12" cy="10" r="2.4" fill="none" stroke="currentColor" stroke-width="1"/>',
};
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  focusable="false"
  set:html={paths[name]}
/>
