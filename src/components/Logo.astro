---
/** The Driftwood mark (a single plank over a waterline, in hairlines) and the wordmark. */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<span class:list={['logo', className]}>
  <svg class="logo-mark" viewBox="0 0 32 32" width="26" height="26" aria-hidden="true" focusable="false">
    <path d="M3.5 19.6 28.5 14.8v3.1L3.5 22.7Z" fill="none" stroke="currentColor" stroke-width="1" stroke-linejoin="miter"></path>
    <path d="M8 20.4 23.5 17.4" fill="none" stroke="currentColor" stroke-width=".6"></path>
    <path d="M2 26.5h28" fill="none" stroke="currentColor" stroke-width="1"></path>
  </svg>
  <span class="logo-word">Driftwood</span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: inherit;
  }
  .logo-mark {
    flex: none;
  }
  .logo-word {
    font-family: var(--serif);
    font-size: 1.7rem;
    font-weight: 300;
    letter-spacing: 0.01em;
    line-height: 1;
  }
</style>
