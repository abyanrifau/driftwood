---
/** Accordion built on <details>, so it needs no JavaScript. */
import type { Faq } from '../data/faq';

interface Props {
  items: Faq[];
  level?: 3 | 4;
}
const { items, level = 3 } = Astro.props;
const Tag = `h${level}` as 'h3' | 'h4';
---

<div class="faq-list">
  {
    items.map((f) => (
      <details class="faq" id={f.id}>
        <summary>
          <Tag class="faq-q">{f.question}</Tag>
          <span class="faq-icon" aria-hidden="true" />
        </summary>
        <div class="faq-a">
          <p>{f.answer}</p>
        </div>
      </details>
    ))
  }
</div>

<style>
  .faq-list {
    border-top: 1px solid var(--hairline);
  }
  .faq {
    border-bottom: 1px solid var(--hairline);
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 60px;
    padding: 1.15rem 0;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .faq-q {
    font-family: var(--serif);
    font-size: var(--step-1);
    font-weight: 400;
    line-height: 1.3;
  }
  summary:hover .faq-q {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
  }
  /* A hairline plus that becomes a minus */
  .faq-icon {
    position: relative;
    flex: none;
    width: 14px;
    height: 14px;
  }
  .faq-icon::before,
  .faq-icon::after {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    width: 14px;
    height: 1px;
    background: currentColor;
    transition: transform 0.5s var(--ease);
  }
  .faq-icon::after {
    transform: rotate(90deg);
  }
  .faq[open] .faq-icon::after {
    transform: rotate(0deg);
  }
  .faq-a {
    padding: 0 2.5rem 1.5rem 0;
    color: var(--ink-soft);
    max-width: var(--measure);
  }
</style>
