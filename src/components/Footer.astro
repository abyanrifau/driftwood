---
import Logo from './Logo.astro';
import { footerNav, site, whatsappLink } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="site-footer cv">
  <div class="container footer-grid">
    <div class="footer-brand">
      <Logo />
      <p class="footer-address">
        {site.location.short}<br />
        Two minutes on foot from the house reef
      </p>
    </div>

    <nav aria-label="Footer">
      <h2 class="footer-head">Pages</h2>
      <ul role="list" class="footer-links">
        {footerNav.map((item) => <li><a href={item.href} data-astro-reload={item.href === '/book/' ? '' : undefined}>{item.label}</a></li>)}
      </ul>
    </nav>

    <div>
      <h2 class="footer-head">Contact</h2>
      <ul role="list" class="footer-contact">
        <li><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></li>
        <li><a href={whatsappLink()}>WhatsApp {site.contact.whatsappDisplay}</a></li>
        <li><a href={site.contact.instagram}>Instagram {site.contact.instagramHandle}</a></li>
      </ul>
      <p class="footer-policy">
        Check-in from {site.policies.checkInLabel}, check-out by {site.policies.checkOutLabel}. {site.policies.cancellation}. {site.policies.breakfast}.
      </p>
    </div>
  </div>

  <div class="container footer-base">
    <p class="concept-line">
      A <a href={site.concept.studioUrl}>Nuit Works</a> concept. Driftwood is a fictional business.
    </p>
    <p class="footer-small">© {year} Driftwood (fictional). Photographs from Unsplash, see <a href="/credits/">credits</a>.</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--ivory);
    border-top: 1px solid var(--hairline);
    padding-top: var(--space-2xl);
    padding-bottom: calc(var(--space-l) + var(--bar-h));
  }
  .footer-grid {
    display: grid;
    gap: var(--space-xl);
  }
  @media (min-width: 900px) {
    .footer-grid {
      grid-template-columns: 1.4fr 1fr 1.2fr;
    }
  }
  .footer-address {
    margin-top: 1.25rem;
    color: var(--ink-soft);
    font-size: var(--step--1);
    line-height: 1.8;
  }
  .footer-head {
    font-family: var(--sans);
    font-size: var(--step--2);
    font-weight: 400;
    letter-spacing: var(--tracking);
    text-transform: uppercase;
    color: var(--taupe-ink);
    margin-bottom: 1rem;
  }
  .footer-links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.1rem 1.5rem;
  }
  .footer-links a,
  .footer-contact a {
    display: inline-flex;
    align-items: center;
    min-height: 34px;
    font-size: var(--step--1);
    text-decoration: none;
  }
  .footer-links a:hover,
  .footer-contact a:hover {
    text-decoration: underline;
  }
  .footer-contact {
    display: grid;
  }
  .footer-policy {
    margin-top: 1rem;
    max-width: 24rem;
    font-size: var(--step--1);
    color: var(--taupe-ink);
  }
  .footer-base {
    display: grid;
    gap: 0.6rem;
    margin-top: var(--space-2xl);
    padding-top: var(--space-m);
    border-top: 1px solid var(--hairline);
  }
  .concept-line {
    font-size: var(--step-0);
    font-weight: 400;
    color: var(--ink);
  }
  .concept-line a {
    text-decoration-color: var(--ink);
  }
  .footer-small {
    font-size: var(--step--1);
    color: var(--taupe-ink);
  }
  @media (min-width: 768px) {
    .footer-base {
      grid-template-columns: 1fr auto;
      align-items: baseline;
    }
  }
</style>
