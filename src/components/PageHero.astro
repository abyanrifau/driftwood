---
/**
 * Opening for inner pages: breadcrumbs, a small label, one thin serif H1 and
 * a short intro, then optionally a full-bleed photo with its own phone crop.
 */
import Breadcrumbs from './Breadcrumbs.astro';
import ArtPhoto from './ArtPhoto.astro';

interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
  trail: { name: string; path: string }[];
  /** mobileKey: an upright photo of the same subject for phones */
  photo?: { key: string; alt: string; caption?: string; focus?: string; mobileFocus?: string; mobileKey?: string };
}
const { eyebrow, title, lede, trail, photo } = Astro.props;
---

<section class:list={['page-hero', { 'page-hero--photo': photo }]}>
  <div class="container">
    <Breadcrumbs trail={trail} />
    <div class="page-hero-text">
      <div class="page-hero-title">
        {eyebrow && <p class="eyebrow">{eyebrow}</p>}
        <h1>{title}</h1>
      </div>
      {
        (lede || Astro.slots.has('default')) && (
          <div class="page-hero-lede">
            {lede && <p class="intro">{lede}</p>}
            <slot />
          </div>
        )
      }
    </div>
  </div>
  {
    photo && (
      <figure class="page-hero-photo">
        <div class="page-hero-img">
          <ArtPhoto
            name={photo.key}
            alt={photo.alt}
            aspect={21 / 9}
            mobileAspect={4 / 5}
            focus={photo.focus}
            mobileFocus={photo.mobileFocus}
            mobileKey={photo.mobileKey}
            widths={[1080, 1600, 2000, 2400]}
            mobileWidths={[480, 750, 1080]}
            quality={{ avif: 40, webp: 58 }}
            mobileQuality={{ avif: 30, webp: 50 }}
            priority
          />
        </div>
        {photo.caption && <figcaption class="container caption">{photo.caption}</figcaption>}
      </figure>
    )
  }
</section>

<style>
  .page-hero {
    padding-block: clamp(1.5rem, 3vw, 2.5rem) var(--space-2xl);
  }
  .page-hero--photo {
    padding-bottom: var(--space-xl);
  }
  .page-hero-text {
    display: grid;
    gap: 1.75rem;
    padding-top: clamp(2.5rem, 7vw, 6rem);
  }
  .page-hero-title {
    display: grid;
    gap: 1.25rem;
  }
  .page-hero-title h1 {
    max-width: 14ch;
    font-size: var(--step-5);
  }
  .page-hero-lede {
    display: grid;
    gap: 1.5rem;
    align-content: end;
  }
  @media (min-width: 1000px) {
    .page-hero-text {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: 3rem;
      align-items: end;
    }
    .page-hero-title {
      grid-column: 1 / span 7;
    }
    .page-hero-lede {
      grid-column: 9 / span 4;
    }
  }
  .page-hero-photo {
    margin-top: var(--space-xl);
  }
  .page-hero-img {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--sand);
  }
  @media (min-width: 768px) {
    .page-hero-img {
      aspect-ratio: 21 / 9;
    }
  }
  .page-hero-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
