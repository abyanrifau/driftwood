---
/**
 * A room as a lookbook spread: a large photo with a small caption, the name
 * in the serif, one line of detail in small caps, the price as a thin line
 * and a square Book button. Alternates its layout down the page.
 */
import Photo from './Photo.astro';
import type { Room } from '../data/rooms';
import { roomDetailLine } from '../data/rooms';
import { bookUrl } from '../lib/booking';

interface Props {
  room: Room;
  /** Position in the list; odd spreads mirror the layout */
  index: number;
  /** Which of the room's photos to show */
  photo?: number;
  level?: 2 | 3;
  /** Shared-element name for the view transition into the room page */
  transition?: boolean;
  priority?: boolean;
  summary?: boolean;
}

const { room, index, photo = 0, level = 3, transition = false, priority = false, summary = true } = Astro.props;
const p = room.photos[photo];
const flip = index % 2 === 1;
const Tag = `h${level}` as 'h2' | 'h3';
const href = `/rooms/${room.slug}/`;
---

<article class:list={['spread', { 'spread--flip': flip }]} aria-labelledby={`spread-${room.slug}`}>
  <div class="spread-media">
    <a href={href} tabindex="-1" aria-hidden="true" class="spread-img frame zoom" data-reveal-img transition:name={transition ? `room-${room.slug}` : undefined}>
      <Photo
        name={p.key}
        alt=""
        aspect={flip ? 4 / 5 : 3 / 2}
        widths={flip ? [480, 750, 960, 1200] : [640, 960, 1280, 1600]}
        sizes={flip ? '(min-width: 900px) 40vw, 100vw' : '(min-width: 900px) 58vw, 100vw'}
        priority={priority}
      />
    </a>
    <p class="caption">{p.caption}</p>
  </div>
  <div class="spread-text" data-reveal>
    <Tag class="spread-name" id={`spread-${room.slug}`}><a href={href}>{room.name}</a></Tag>
    <p class="meta">{roomDetailLine(room)}</p>
    {summary && <p class="spread-summary">{room.highlight}.</p>}
    <p class="price-line">From ${room.fromPrice} per night</p>
    <div class="spread-actions">
      <a class="btn btn--small" href={bookUrl({ room: room.slug })} data-astro-reload data-booking-start aria-label={`Book the ${room.name}`}>Book</a>
      <a class="text-link" href={href} aria-label={`View room: ${room.name}`}>View room</a>
    </div>
  </div>
</article>

<style>
  .spread {
    display: grid;
    gap: 1.75rem;
    align-items: end;
  }
  .spread-media {
    min-width: 0;
  }
  .spread-img {
    display: block;
  }
  .spread-text {
    display: grid;
    gap: 0.9rem;
    justify-items: start;
    max-width: 26rem;
  }
  .spread-name {
    font-size: var(--step-3);
    font-weight: 300;
  }
  .spread-name a {
    text-decoration: none;
  }
  .spread-name a:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
  }
  .spread-summary {
    color: var(--ink-soft);
  }
  .spread-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
    margin-top: 0.4rem;
  }
  @media (min-width: 900px) {
    .spread {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: clamp(1.5rem, 3vw, 3rem);
    }
    .spread-media {
      grid-column: 1 / span 7;
    }
    .spread-text {
      grid-column: 9 / span 4;
      padding-bottom: 3.5rem;
    }
    .spread--flip {
      align-items: center;
    }
    .spread--flip .spread-media {
      grid-column: 7 / span 5;
      grid-row: 1;
    }
    .spread--flip .spread-text {
      grid-column: 2 / span 4;
      grid-row: 1;
      padding-bottom: 0;
    }
  }
</style>
